{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Info Koordinasi",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "unit",
          "updated"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "description": "Unit atau layanan"
          },
          "region": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  }
}
